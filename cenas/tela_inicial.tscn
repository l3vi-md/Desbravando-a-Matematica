[sub_resource type="GDScript" id="GDScript_qtomq"]
script/source = "extends Node2D

func _ready() -> void:
	pass 

func _process(delta: float) -> void:
	pass

var button_type = null

func _on_jogar_pressed() -> void:
	#get_tree().change_scene_to_file()
	button_type = \"jogar\"
	$ColorRect.show()
	$ColorRect/fade_time.start()
	$ColorRect/AnimationPlayer.play(\"Fade_in\")
	
	pass

func _on_fases_pressed() -> void:
	#get_tree().change_scene_to_file()
	pass 
	button_type = \"fases\"
	$ColorRect.show()
	$ColorRect/fade_time.start()
	$ColorRect/AnimationPlayer.play(\"Fade_in\")

func _on_resumo_pressed() -> void:
	pass
	button_type = \"resumo\"
	$ColorRect.show()
	$ColorRect/fade_time.start()
	$ColorRect/AnimationPlayer.play(\"Fade_in\")
	get_tree().quit()
	


func _on_fade_time_timeout() -> void:
	if button_type == \"jogar\" :
		get_tree().change_scene_to_file(\"res://cenas/game.tscn\")
	elif button_type == \"resumo\" :
		get_tree().quit()
	#elif button_type == \"fases\" :
		#get_tree().change_scene_to_file()
"

